# npm 10.9.x crashes while resolving this dependency graph's peer set:
# `TypeError: Cannot read properties of null (reading 'edgesOut')` thrown from
# arborist's `#loadPeerSet` on node_modules/nuxt. It is a crash, not an ERESOLVE
# report — npm explains real conflicts, it does not throw on them — so the tree
# is buildable and only npm's resolver is at fault.
#
# Setting this here rather than passing --legacy-peer-deps on the command line
# means `npm install`, `npm ci`, a developer's laptop and CI all build the same
# tree from the same file, with no flag to forget. The safety this gives up is
# npm's automatic peer checking, so every version in package.json is pinned
# exactly and the peer ranges that matter were checked by hand:
# @nuxt/test-utils@4.2.0 requires vitest ^4.0.2 (pinned 4.1.11) and
# happy-dom >=20.0.11 (pinned 20.14.0); @nuxt/ui@4.11.0 requires
# tailwindcss ^4.0.0 (pinned 4.3.3) and typescript ^5.6.3 (pinned 5.9.3);
# @pinia/nuxt@1.0.2 requires pinia ^4.0.3 (pinned 4.0.3).
legacy-peer-deps=true

# Reproducibility over freshness: a range in package.json is a decision nobody
# made, and this is the frontend the deployment serves.
save-exact=true
