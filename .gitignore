# --- Secrets: never commit. Anything here is enough to impersonate you. ------
# Comments must sit on their own line: git treats a mid-line '#' as literal
# text, so a trailing comment silently breaks the pattern it documents.
.env
.env.*
!.env.example

# ANTHROPIC_API_KEY in plaintext, Claude side then Codex side.
.claude/settings.local.json
.codex/config.toml

# Job-board logins, live session cookies, client names under NDA.
data/site_credentials.json
data/browser_state/
data/mandate_redactions.json
**/storage_state*.json

# --- Personal data: your identity, your applications, your history ----------
# answers.yaml carries name, address, date of birth and phone.
data/answers.yaml
data/*.db
data/*.db-wal
data/*.db-shm
data/backups/
data/digest_latest.md
data/logs/
data/screenshots/
data/cover_letters/
data/tailored/
data/upload_staging/

# Whisper weights: large binary, not a secret.
data/models/

# The CV library and every rendered PDF carry full contact details.
cv/base_cv.yaml
cv/base_cv_dev.yaml
cv_versions/
*.pdf

# The Excel tracker (folder name uses U+2019).
Rechercher d’emploi/

# --- Local configuration ----------------------------------------------------
# auto_apply, score thresholds, schedule: machine-specific.
data/settings.json

# --- Build output and caches ------------------------------------------------
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
# Nuxt: .nuxt and .output are regenerated by `nuxt prepare` / `nuxt generate`.
# `.output/public` is what FastAPI serves (pipeline.paths.FRONTEND_DIST), so it is
# build output like webapp/dist was before it — generated, never committed.
# package-lock.json is NOT ignored — `npm ci` in CI depends on it.
#
# `frontend/dist` has no trailing slash on purpose: `nuxt generate` recreates it on
# every run as a symlink to .output/public (Nuxt 2 deployment compatibility), and
# git matches a symlink as a file, so a `dist/` pattern would leave it untracked
# and visible. Its target is an absolute host path, which is exactly what must not
# be committed.
frontend/node_modules/
frontend/.nuxt/
frontend/.output/
frontend/dist
frontend/playwright-report/
frontend/test-results/
.firecrawl/
.playwright-mcp/

# --- OS noise ---------------------------------------------------------------
.DS_Store
