# Copy to terminal.env and fill in. terminal.env is gitignored.
#
# This is intentionally separate from .env: terminal-manager has access to the
# Docker socket and must receive only its own Claude Code gateway configuration.
# Do not export these values in your shell. Do not put user credentials, plugins,
# host status-line scripts, or Claude permission-bypass settings in this file.

ANTHROPIC_API_KEY=
# An HTTPS Anthropic-compatible endpoint. For AgentRouter use its documented
# HTTPS origin; localhost is not reachable as the terminal container's host.
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Use a model name that the selected gateway actually exposes.
ANTHROPIC_MODEL=
