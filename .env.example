# Copy to .env and fill in. .env is gitignored.

# Free key from https://jooble.org/api/about — powers pipeline/sources/jooble.py.
# Without it, the "jooble" discovery source reports ok:false and is skipped.
JOOBLE_API_KEY=

# Password the applier uses when it has to create an account on an employer's
# job portal (Umantis, jobup, ...). Leave empty to generate a strong random one
# per site: either way it is saved to data/site_credentials.json so you can log
# in by hand. Never commit a real password to source. V1 only — the V2 workflows
# never read that file (docs/CREDENTIAL_SECURITY.md).
SITE_ACCOUNT_PASSWORD=

# --- V2 database (docs/PERSISTENCE.md) -------------------------------------
# Development values only. docker-compose.yml interpolates the five POSTGRES_*
# variables; no container reads this file, so nothing above is ever passed into
# the database. The port is published on 127.0.0.1 only.
POSTGRES_USER=jobsearch
POSTGRES_PASSWORD=jobsearch_dev_only
POSTGRES_DB=jobsearch_dev
# Created once, on first initialization of the data directory. The test suite
# drops and recreates this schema, so it must never be the development database.
POSTGRES_TEST_DB=jobsearch_test
# Not 5432: your own PostgreSQL keeps that port.
POSTGRES_PORT=55432

# How a process on the host reaches the compose database — alembic, the V1
# import, the API. JOBSEARCH_DATABASE_URL wins over DATABASE_URL, which lets a
# DATABASE_URL exported for another project stay harmless. Both are optional:
# unset, the code falls back to exactly the URL below.
JOBSEARCH_DATABASE_URL=postgresql+psycopg://jobsearch:jobsearch_dev_only@127.0.0.1:55432/jobsearch_dev

# The database `pytest` is allowed to drop and rebuild. Read only by
# DatabaseSettings.for_tests, which ignores the two variables above on purpose.
JOBSEARCH_TEST_DATABASE_URL=postgresql+psycopg://jobsearch:jobsearch_dev_only@127.0.0.1:55432/jobsearch_test

# --- V2 geocoding (docs/GEO_SEARCH.md) -------------------------------------
# Read only by the offline enrichment pass, `python -m backend.app.cli.geocode`.
# The API never geocodes on a request: it reads coordinates this pass has already
# stored, so leaving these unset degrades nothing a user sees — it only means the
# CLI refuses to start rather than writing rows it cannot resolve.
#
# Required to run the pass. The OpenStreetMap Nominatim terms require a User-Agent
# that names your deployment; the httpx default gets a deployment blocked, so the
# CLI will not start without one. Use something a provider can identify you by.
GEOCODER_USER_AGENT=
# Optional. The address an operator is reachable at, sent when the provider's
# terms ask for one (Nominatim's do, for bulk use). A deployment contact, not a
# candidate's and not a secret.
GEOCODER_CONTACT_EMAIL=
# Optional, and NOT the key itself. This names the environment variable that holds
# the key (e.g. GEOCODER_API_KEY=NOMINATIM_TOKEN, then NOMINATIM_TOKEN=<the key>).
# The value is validated against ^[A-Z][A-Z0-9_]*$: a real token has lower-case
# letters, dashes or dots and simply will not fit, so a leaked credential here is
# a startup error rather than a commit. Nominatim's public server needs no key.
GEOCODER_API_KEY=

# --- V2 credential encryption (docs/CREDENTIAL_SECURITY.md) ----------------
# The only user credential V2 persists is a remote LLM connection's API key, and
# it is stored encrypted at rest (Fernet). The master key comes from here, never
# from the database: a dump therefore holds ciphertext and a version tag and
# nothing that decrypts them. Leave everything below unset if you use only CLI
# (Claude Code, Codex) and keyless local providers — nothing is encrypted then.
#
# The active key. Generate one with the library that consumes it —
#   python -c "from backend.app.llm.secrets import generate_master_key; print(generate_master_key())"
# — and store it in your secret manager, not in a committed file. Rotating it
# means setting a new value here, bumping the version, and keeping the old key
# below (docs/CREDENTIAL_SECURITY.md).
JOBSEARCH_LLM_SECRET_KEY=
# The version new ciphertext is written under. Defaults to 1; bump it by one for
# each rotation so old and new keys never share a version.
JOBSEARCH_LLM_SECRET_KEY_VERSION=1
# Rotation window only. A previous key stays available under its own version so
# rows it wrote still decrypt while `rotate_credentials` re-encrypts them: set
# JOBSEARCH_LLM_SECRET_KEY_V1=<the v1 key> when the active version is 2, and
# remove it once a clean rotation reports zero failures. The suffix is the
# version it decrypts (digits only), so it can never be the active version.
#JOBSEARCH_LLM_SECRET_KEY_V1=

# --- V2 account data export (docs/CAREER_INTELLIGENCE_OS_V2.md §23-25) ------
# An account export is a portable, secret-free copy of everything the platform
# holds about one user. Both variables are optional and default to the values
# below; a production deployment on object storage would grow its own settings
# rather than overloading the local root.
#
# The directory the local export store writes JSON archives under. Owner-scoped,
# id-derived files (exports/<user_id>/<export_id>.json). An object-store adapter
# replaces this store without the service changing.
JOBSEARCH_EXPORT_ARTIFACT_ROOT=var/account_exports
# How long a produced archive stays downloadable before the retention sweep may
# purge it. An export is a temporary, portable copy, not a second permanent
# store, so it expires by design; must be >= 1 (a non-positive window would make
# every archive born already-expired). Default 168 hours (seven days).
JOBSEARCH_EXPORT_RETENTION_HOURS=168

# --- PostgreSQL backup & recovery (Phase 16 §45-48) ------------------------
# `pg_dump`/`pg_restore`/`psql` are the backup tooling. The one credential (the
# database password) is read from the DATABASE_URL above and handed to the libpq
# child through its ENVIRONMENT — it is never placed on a command line or in any
# backup output, so nothing here is a secret. All four variables are optional.
#
# Where timestamped custom-format dumps (jobsearch-<UTC>.dump) are written. A
# relative path is resolved against the repository root; gitignored so a dump is
# never committed.
JOBSEARCH_BACKUP_ARTIFACT_ROOT=var/backups
# Local dumps older than this many days are eligible for `backup.sh prune`. Must
# be >= 1. Default 30. A cold-storage/offsite copy has its own, longer, policy.
JOBSEARCH_BACKUP_RETENTION_DAYS=30
# Pin the libpq client binaries when the client major must match the server
# (pg_restore refuses a dump from a newer server). Default to the bare names,
# resolved on PATH.
#JOBSEARCH_PG_DUMP_PATH=pg_dump
#JOBSEARCH_PG_RESTORE_PATH=pg_restore
#JOBSEARCH_PSQL_PATH=psql

# --- Rate limiting (Phase 16 §49-52, docs/RATE_LIMITING.md) -----------------
# Abuse-prone endpoints (register, login, re-auth-sensitive deletion, chat/LLM
# generation, document generation, export generation, checkout creation) are
# rate limited with a horizontal-safe fixed window shared across web workers via
# Redis. This is *additive*: it never weakens the DB-backed account lockout or
# any other authentication protection. Every variable is optional; the defaults
# protect a deployment with no configuration.
#
# Master switch. On by default; set to a false-y value to turn it off entirely
# (the limiter is then never consulted).
#JOBSEARCH_RATE_LIMIT_ENABLED=true
# The Redis the window counters live in, shared with the task queue. Resolved
# most-specific-first: JOBSEARCH_REDIS_URL wins over REDIS_URL. Carries a
# password in production, so it is treated as a secret and never logged.
#JOBSEARCH_REDIS_URL=redis://127.0.0.1:56379/0
# How many reverse proxies you trust in front of the app. 0 (the default) means
# X-Forwarded-For is NOT trusted and the socket peer is the client identity —
# the safe default, since a forwarded header is otherwise attacker-controlled.
# Set to the number of proxies that append to X-Forwarded-For (e.g. 1 behind a
# single load balancer) so the real client is read from the right position.
#JOBSEARCH_RATE_LIMIT_TRUSTED_PROXY_COUNT=0
# Per-category windows: <MAX_EVENTS> events per <WINDOW_SECONDS>. Each category
# is its own bucket, so exhausting one never locks out another; both halves of a
# pair must be >= 1. The values below are the built-in defaults.
#JOBSEARCH_RATE_LIMIT_REGISTER_MAX_EVENTS=20
#JOBSEARCH_RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
#JOBSEARCH_RATE_LIMIT_LOGIN_MAX_EVENTS=60
#JOBSEARCH_RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
#JOBSEARCH_RATE_LIMIT_REAUTH_MAX_EVENTS=10
#JOBSEARCH_RATE_LIMIT_REAUTH_WINDOW_SECONDS=3600
#JOBSEARCH_RATE_LIMIT_CHAT_MAX_EVENTS=30
#JOBSEARCH_RATE_LIMIT_CHAT_WINDOW_SECONDS=60
#JOBSEARCH_RATE_LIMIT_DOCUMENT_MAX_EVENTS=20
#JOBSEARCH_RATE_LIMIT_DOCUMENT_WINDOW_SECONDS=3600
#JOBSEARCH_RATE_LIMIT_EXPORT_MAX_EVENTS=5
#JOBSEARCH_RATE_LIMIT_EXPORT_WINDOW_SECONDS=3600
#JOBSEARCH_RATE_LIMIT_CHECKOUT_MAX_EVENTS=10
#JOBSEARCH_RATE_LIMIT_CHECKOUT_WINDOW_SECONDS=3600

