# Copy to .env and fill in. .env is gitignored.

# Free key from https://jooble.org/api/about — powers pipeline/sources/jooble.py.
# Without it, the "jooble" discovery source reports ok:false and is skipped.
JOOBLE_API_KEY=

# Password the applier uses when it has to create an account on an employer's
# job portal (Umantis, jobup, ...). Leave empty to generate a strong random one
# per site: either way it is saved to data/site_credentials.json so you can log
# in by hand. Never commit a real password to source.
SITE_ACCOUNT_PASSWORD=

# --- V2 database (docs/PERSISTENCE.md) -------------------------------------
# Development values only. docker-compose.yml interpolates the five POSTGRES_*
# variables; no container reads this file, so nothing above is ever passed into
# the database. The port is published on 127.0.0.1 only.
POSTGRES_USER=jobsearch
POSTGRES_PASSWORD=jobsearch_dev_only
POSTGRES_DB=jobsearch_dev
# Created once, on first initialization of the data directory. The test suite
# drops and recreates this schema, so it must never be the development database.
POSTGRES_TEST_DB=jobsearch_test
# Not 5432: your own PostgreSQL keeps that port.
POSTGRES_PORT=55432

# How a process on the host reaches the compose database — alembic, the V1
# import, the API. JOBSEARCH_DATABASE_URL wins over DATABASE_URL, which lets a
# DATABASE_URL exported for another project stay harmless. Both are optional:
# unset, the code falls back to exactly the URL below.
JOBSEARCH_DATABASE_URL=postgresql+psycopg://jobsearch:jobsearch_dev_only@127.0.0.1:55432/jobsearch_dev

# The database `pytest` is allowed to drop and rebuild. Read only by
# DatabaseSettings.for_tests, which ignores the two variables above on purpose.
JOBSEARCH_TEST_DATABASE_URL=postgresql+psycopg://jobsearch:jobsearch_dev_only@127.0.0.1:55432/jobsearch_test
